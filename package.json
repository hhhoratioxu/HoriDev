{
  "name": "horidev",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs && pnpm db:migrate",
    "dev": "pnpm build:web && concurrently -k -n worker,web \"wrangler dev --ip 127.0.0.1 --port 8787\" \"vite --host 127.0.0.1\"",
    "preview": "wrangler dev --ip 127.0.0.1 --port 8787",
    "build:web": "vite build",
    "build": "pnpm typecheck && pnpm build:web && wrangler deploy --dry-run --env=\"\" --outdir dist-worker",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "deploy": "node scripts/deploy.mjs",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "admin:grant": "node scripts/admin-grant.mjs",
    "test:live": "node scripts/live-smoke.mjs"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.14",
    "better-auth": "1.7.14",
    "drizzle-orm": "0.45.4",
    "fflate": "0.8.3",
    "hono": "4.13.14",
    "lucide-react": "1.62.0",
    "monaco-editor": "0.57.0",
    "openai": "7.45.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261028.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "concurrently": "10.0.6",
    "drizzle-kit": "0.31.11",
    "esbuild": "0.28.2",
    "eslint": "^10.0.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "jsonc-parser": "3.3.1",
    "miniflare": "4.20260730.0",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "~6.0.0",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "wrangler": "4.155.0"
  }
}
